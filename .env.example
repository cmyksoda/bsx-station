STATION_NAME=BS-X GX
STATION_ROM_DIR=/srv/bsx-station/roms
STATION_CATALOG=/srv/bsx-station/catalog.yml
STATION_CACHE_DIR=/srv/bsx-station/cache
STATION_SLOT_MINUTES=30
STATION_GAMES_PER_SLOT=1
STATION_SEED=satellaview
STATION_MESSAGE=Welcome to {station}! On air now: {title}.
# building the download folder lives in (2 = Broadcast Station) and the host's face (0-16, or cycle)
STATION_BUILDING=2
STATION_MUGSHOT=cycle
# 0 never, 1 ask after download, 2 always start
STATION_AUTOSTART=1
# the address the TV guide shows for Wiis (blank: the one the guide was opened at)
STATION_ADDRESS=
