[Unit]
Description=bsx-station (Satellaview broadcasts for BS-X GX)
After=network-online.target

[Service]
WorkingDirectory=/srv/bsx-station/app
EnvironmentFile=/srv/bsx-station/app/.env
ExecStart=/usr/local/bin/uv run uvicorn --factory station.app:create_app --host 0.0.0.0 --port 8080
Restart=on-failure
User=bsx-station

[Install]
WantedBy=multi-user.target
